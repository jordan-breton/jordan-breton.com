uniform float uTime;

varying vec2 vUv;
varying float vNoise;
varying float vVoronoi1;
varying float vVoronoi2;

void main() {
    vec3 baseColor = vec3(1.0, 0.0, 0.0) * 250.0;
    vec3 firstColor = vec3(1.0, 1.0, 0.0) * 1.0;
    vec3 secondColor = vec3(1.1, 0.6, 0.05) * 1.0;

    vec2 wavedUV = vUv;
    vec2 uv = vUv * 0.15;

    float time = uTime * 3.0;

    // Create turbulent fire-like movement
    float t1 = -time * 1.5;
    float t2 = -time * 2.3;
    float t3 = -time * 3.1;

    // Layered sine waves for fire flicker
    float flicker1 = sin(wavedUV.y * 8.0 + t1) * cos(wavedUV.x * 6.0 + t2);
    float flicker2 = sin(wavedUV.y * 12.0 + t2) * cos(wavedUV.x * 10.0 + t3);
    float flicker3 = sin(wavedUV.y * 16.0 + t3) * cos(wavedUV.x * 14.0 + t1);

    // Fire intensity grows stronger toward the top
    float heightFactor = smoothstep(0.0, 1.0, vUv.y);
    float fireIntensity = pow(heightFactor, 3.0);

    // Combine flickering with intensity
    float fireDistortion = (flicker1 * 0.5 + flicker2 * 0.3 + flicker3 * 0.2) * fireIntensity;

    // Apply distortion (mainly horizontal for flame flicker)
    wavedUV.x -= fireDistortion * 0.2;
    wavedUV.y += fireDistortion * 0.2;

    float fire = (vVoronoi1 - vVoronoi2);

    float yGradient = smoothstep(0.0, 1.0, vUv.y);
    float secondGradient = 1.0 - smoothstep(0.0, 0.5, vUv.y + sin(vUv.x * 12.0 + 4.9) * 0.2 + 0.15);
    secondGradient -= max(vVoronoi2 * 12.0 * vUv.y, 0.0);
    secondGradient = smoothstep(0.0, 1.0, secondGradient);
    // yGradient += secondGradient;

    fire *= 1.0 - yGradient;
    fire += secondGradient /** vVoronoi2*/;

    // THis is smoke :)
    // float circle = distance(vec2(0.5, 0.28), vec2(wavedUV.x, wavedUV.y * 0.25 /*+ disturbedNoise * 0.3*/) + mixed * 0.05);
    // circle = pow(circle, 1.8);

    float circle = distance(
        vec2(0.5, 0.18),
        vec2(wavedUV.x + vNoise * 0.075, wavedUV.y * 0.7)
    );
    circle = pow(circle, 1.8);

    // circle = 1.0 - step(0.05, circle);
    circle = 1.0 - smoothstep(0.0, 0.05, circle);
    circle *= secondGradient;

    float outerCircle = step(0.1, circle);
    float innerCircle1 = step(0.30, circle);
    // circle *= step(0.2, noise * 0.5 * (yGradient));
    // circle = step(0.2, circle);
    // circle = 1.0 - circle;

    float outerFireShape = step(0.4, fire);
    float fireShape = step(0.41, fire);
    float innerFireShape = smoothstep(0.50, 1.0, fire);
    float innerFireShape2 = smoothstep(0.95, 1.3, fire);
    float glowingOutline = outerFireShape * outerCircle - fireShape * outerCircle;
    float finalShape = fireShape * innerCircle1;

    vec3 color = baseColor * (outerFireShape - innerFireShape);
    color += firstColor * (innerFireShape - innerFireShape2);
    color += secondColor * (innerFireShape2);
    // color += firstColor * (innerFireShape) * vVoronoi1;

    float alpha = outerFireShape * outerCircle;
    alpha -= smoothstep(0.0, 1.0, vVoronoi2 ) * innerFireShape2;

    gl_FragColor = vec4(
        vec3(color),
        clamp(alpha, 0.0, 1.0)
    );
}