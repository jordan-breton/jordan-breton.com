uniform vec3 uColor;
varying float vAlpha;
varying float vRand; // pass a random per-particle float

// --- Helpers ---
float polygonShape(vec2 uv, float sides) {
    uv = uv * 2.0 - 1.0; // [-1,1] space
    float a = atan(uv.x, uv.y) + 3.14159;
    float r = length(uv);
    float angle = 6.28318 / sides;
    return cos(floor(0.5 + a / angle) * angle - a) * r;
}

void main() {
    vec2 uv = gl_PointCoord;

    // pick polygon sides
    float sides = 3.0 + floor(mod(vRand * 13.0, 5.0)); // 3–7

    // --- random squash/stretch ---
    float scaleX = 0.6 + fract(sin(vRand * 123.45) * 43758.5453) * 0.8; // 0.6–1.4
    float scaleY = 0.6 + fract(sin(vRand * 543.21) * 78901.2345) * 0.8;
    uv = (uv - 0.5) * vec2(scaleX, scaleY) + 0.5; // scale around center

    // polygon distance
    float d = polygonShape(uv, sides);

    if (d > 0.5) discard;

    float alpha = (1.0 - d * 2.0) * vAlpha;
    gl_FragColor = vec4(uColor * 50.0, alpha);
}
