#include ../../shaders/terrain.glsl;
#include <fog_pars_vertex>

uniform float     uTime;
uniform vec2      uResolution;
uniform float     uSize;
uniform sampler2D uDisplacementMap;
uniform sampler2D uBendingTexture;
uniform vec2      uMousePosition;
uniform float     uHeightFactor;
uniform float     uBendingFactor;
uniform sampler2D uWindTexture;

attribute vec2  aUv;
attribute float aSize;
attribute float aRotation;
attribute vec2  aDeformation;
attribute float aColorMix;
attribute vec3  aNormal;

varying vec2  vUv;
varying float vColorVariation;
varying vec3  vPosition;
varying float vRotation;
varying vec2  vDeformation;
varying float vAppliedWind;
varying float vColorMix;

void main() {
    vec3 newPosition       = position;
    vec3 flowerOrigin      = position;
    vec3 flowerNormal      = normalize(aNormal);
    vec3 flowerInclination = flowerNormal;

    //region Terrain pseudo-deformation

    float elevation = getElevation(flowerOrigin.xz, uDisplacementMap);
    newPosition    += aNormal * elevation;

    //endregion Terrain pseudo-deformation
    //region Wind

    float windNoise = getWindStrength(flowerOrigin.xz, uWindTexture, uTime);

    vec3 worldUp = vec3(0.0, 1.0, 0.0);

    // Create a tangent wind direction
    vec3 windDirection = cross(flowerNormal, worldUp);
    // Handle the case where normal is parallel to up
    if (length(windDirection) < 0.01 || length(windDirection) > -0.01) {
        windDirection = cross(flowerNormal, vec3(1.0, 0.0, 0.0));
    }
    windDirection = normalize(windDirection);

    // Make it tangent to sphere (project out normal component)
    windDirection = windDirection - dot(windDirection, flowerNormal) * flowerNormal;
    windDirection = normalize(windDirection);

    // TODO: make it a uniform
    float windStrength = 0.4;
    windStrength      *= -windNoise;

    flowerInclination = inclineVectorTowardSlerp(
        flowerInclination,
        windDirection,
        windStrength
    );

    //endregion Wind
    //region Mouse bending

    vec2  bendUv           = aUv;
    vec4  bendData         = texture(uBendingTexture, bendUv).rgba;
    float bendingIntensity = bendData.r * uBendingFactor;
    vec3  bendingDirection = bendData.gba * 2.0 - 1.0;
    bendingDirection       = bendingDirection;

    // Use in slerp function
    flowerInclination = inclineVectorTowardSlerp(
        flowerInclination,
        normalize(bendingDirection),
        bendingIntensity
    );

    //endregion MouseBending
    //region Apply inclination

    vec3 offset = newPosition - flowerOrigin;
    newPosition = flowerOrigin + (flowerInclination * elevation);

    //endregion Apply inclination
    //region Applying matrices

    vec4 modelPosition     = modelMatrix * vec4(newPosition, 1.0);
    vec4 mvPosition        = viewMatrix * modelPosition;
    vec4 projectedPosition = projectionMatrix * mvPosition;
    gl_Position            = projectedPosition;

    //endregion Applying matrices
    //region Size

    gl_PointSize = uSize * uResolution.y * aSize;
    gl_PointSize *= (1.0 / -mvPosition.z);

    //endregion Size
    //region Setting varyings

    vColorVariation = aSize * 0.9;
    vPosition       = position;
    vRotation       = aRotation;
    vDeformation    = aDeformation;
    vAppliedWind    = windStrength;
    vColorMix       = aColorMix;

    //endregion

    #include <fog_vertex>
}