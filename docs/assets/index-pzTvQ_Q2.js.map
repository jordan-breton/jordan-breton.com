uniform vec2 uMouseUv;
uniform vec3 uDirection;
uniform float uBrushRadius;
uniform float uDelta;
uniform float uFadingFactor;

varying vec2 vUv;

void main() {
    vec2 uv = vUv;
    vec4 texel = texture2D(uTextureBending, uv);

    float fading = uDelta * uFadingFactor;

    // Fade
    texel.r = mix(texel.r, 0.0, fading);
    texel.g = mix(texel.g, 0.5, fading);
    texel.b = mix(texel.b, 0.5, fading);
    texel.a = mix(texel.a, 0.5, fading);

    float distToMouse = distance(uv, uMouseUv);
    if (distToMouse < uBrushRadius) {
        float strength = 1.0 - smoothstep(0.0, uBrushRadius, distToMouse);
        texel.r = mix(texel.r, 1.0,                      strength);  // Bending strength
        texel.g = mix(texel.g, uDirection.x * 0.5 + 0.5, strength);  // X direction
        texel.b = mix(texel.b, uDirection.y * 0.5 + 0.5, strength);  // Y direction
        texel.a = mix(texel.a, uDirection.z * 0.5 + 0.5, strength);  // Z direction
    }

    gl_FragColor = texel;
}
