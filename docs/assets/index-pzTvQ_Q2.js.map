attribute float textureRotation;
attribute float scaleVariation;
attribute vec3 bushCenter;
attribute float leafPhase;
attribute float bushPhase;
attribute float baseLighting; // Pre-calculated lighting coefficient
attribute vec3 channelMask;

uniform float time;
uniform float windStrength;
uniform vec3 lightDirection;
uniform float aoStrength;

varying vec3 vInstanceColor;
varying vec2 vUv;
varying float vLightIntensity;
varying float vAmbientOcclusion;
varying vec3 vWorldPos;
varying vec3 vChannelMask;

float calculateAmbientOcclusion(vec3 leafPos, vec3 bushCenter, float bushRadius) {
    // Distance from bush center (0.0 = center, 1.0 = edge)
    float distanceFromCenter = length(leafPos - bushCenter) / bushRadius;

    // Height factor - lower leaves get less light
    float heightFactor = clamp((leafPos.y - bushCenter.y) / bushRadius * 0.5 + 0.5, 0.0, 1.0);

    // Depth factor - leaves deeper in the bush are darker
    float depthFactor = clamp(distanceFromCenter, 0.0, 1.0);

    // Combine for AO - inner and lower leaves are darker
    float ao = mix(0.2, 1.0, depthFactor * 0.6 + heightFactor * 0.4);
    return mix(1.0, ao, aoStrength);
}

void main() {
    vInstanceColor = instanceColor;
    vChannelMask = channelMask;

    // Apply texture rotation to UV coordinates
    vec2 centeredUv = uv - 0.5;
    float cosRot = cos(textureRotation);
    float sinRot = sin(textureRotation);
    mat2 rotationMatrix = mat2(cosRot, -sinRot, sinRot, cosRot);
    vec2 rotatedUv = rotationMatrix * centeredUv + 0.5;
    vUv = rotatedUv;

    // Get the instance position
    vec3 originalPos = (instanceMatrix * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
    vec3 instancePos = originalPos;

    // Wind animation calculations (same as before)
    float leafWindTime = time * 3.0 + leafPhase;
    float bushWindTime = time * 1.5 + bushPhase;

    float windWave1 = sin(time * 0.8 + bushPhase * 0.5) * 0.5 + 0.5;
    float windWave2 = sin(time * 1.5 + leafPhase * 0.3) * 0.5 + 0.5;
    float windWave3 = sin(time * 2.2 + bushPhase * 0.8) * 0.5 + 0.5;

    float windIntensity = windWave1 * windWave2 * windWave3;
    windIntensity = 0.3 + windIntensity * 0.7;

    float spatialWind = sin(originalPos.x * 0.1 + originalPos.z * 0.1 + time * 0.8) * 0.2 + 0.8;
    windIntensity *= spatialWind;

    float heightFromGround = originalPos.y - bushCenter.y;
    float maxBushHeight = 5.0;
    float normalizedHeight = clamp(heightFromGround / maxBushHeight, 0.0, 1.0);
    float heightMultiplier = 0.2 + normalizedHeight * 0.8;
    windIntensity *= heightMultiplier;
    windIntensity *= windStrength;

    // Calculate lighting
    vec3 originalToBushEdge = normalize(originalPos - bushCenter);
    float lightAlignment = dot(originalToBushEdge, -lightDirection);
    float directionalLight = clamp(lightAlignment * 0.5 + 0.5, 0.1, 1.0);

    // Combine with pre-calculated base lighting
    vLightIntensity = directionalLight * baseLighting;

    // Calculate ambient occlusion
    vAmbientOcclusion = calculateAmbientOcclusion(instancePos, bushCenter, 3.5);

    // Store world position for fragment shader
    vWorldPos = instancePos;

    // Billboarding (same as before)
    vec3 cameraRight = vec3(modelViewMatrix[0][0], modelViewMatrix[1][0], modelViewMatrix[2][0]);
    vec3 cameraUp = vec3(modelViewMatrix[0][1], modelViewMatrix[1][1], modelViewMatrix[2][1]);

    float leafRotationAngle = sin(leafWindTime) * cos(leafWindTime * 1.3) * 0.2 * windIntensity;
    float leafCos = cos(leafRotationAngle);
    float leafSin = sin(leafRotationAngle);

    vec3 rotatedRight = cameraRight * leafCos + cameraUp * leafSin;
    vec3 rotatedUp = -cameraRight * leafSin + cameraUp * leafCos;

    float finalScale = 0.4 * scaleVariation;

    vec3 billboardPos = instancePos +
                        position.x * rotatedRight * finalScale +
                        position.y * rotatedUp * finalScale;

    gl_Position = projectionMatrix * modelViewMatrix * vec4(billboardPos, 1.0);
}