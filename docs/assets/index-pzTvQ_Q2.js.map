varying vec3 vColor;
varying float vAlpha;

void main() {
    // Calculate distance from center of point
    vec2 coord = gl_PointCoord - 0.5;
    float distance = length(coord);

    // Create circular drop shape
    float circle = 1.0 - smoothstep(0.4, 0.5, distance);

    // Create inner highlight for more realistic water drop look
    // float innerHighlight = 1.0 - smoothstep(0.0, 0.2, distance);

    // Create outer rim for definition
    // float outerRim = smoothstep(0.35, 0.4, distance) * smoothstep(0.5, 0.45, distance);

    // Combine effects
    float alpha = circle * vAlpha;

    // Discard pixels outside the circle
    if (alpha < 0.01) {
        discard;
    }

    // Create water-like color mixing
    vec3 finalColor = vec3(1.0);

    // Add bright highlight in center (like light reflection on water)
    // finalColor = mix(finalColor, vec3(1.0, 1.0, 1.0), innerHighlight * 0.3);

    // Add subtle rim lighting
    // finalColor = mix(finalColor, vec3(0.8, 0.9, 1.0), outerRim * 0.2);

    // Apply final color and alpha
    gl_FragColor = vec4(finalColor, 1.0);
}