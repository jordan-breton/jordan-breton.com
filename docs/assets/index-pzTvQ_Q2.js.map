uniform float uThickness;
uniform vec3  uCameraPosition;
uniform float uProgress;

attribute float aVertexId;
attribute vec3  aTangent;
attribute float aCurveProgression;

varying float vThicknessFactor;
varying float vThicknessVariation;

void main() {
    //region Appearance

    float thicknessMove = smoothstep(0.2, 0.0, 0.2)
                          + smoothstep(0.8, 0.3, uProgress)
                          + smoothstep(0.8, 1.0, 0.2);

    // general wind line shape
    float shape = smoothstep(0.0, 0.5, aCurveProgression)
                - smoothstep(0.5, 1.0, aCurveProgression);

    // Modulates the thickness / opacity along the shape
    float thicknessFactor = smoothstep(0.0, thicknessMove, aCurveProgression)
                          - smoothstep(thicknessMove, 1.0, aCurveProgression);

    // Combines both
    thicknessFactor *= shape;

    // We make thickness vary with progression
    float globalThicknessAnimation = smoothstep(0.0, 0.5, uProgress)
                                   - smoothstep(0.5, 1.0, uProgress);

    float thicknessInfluence = globalThicknessAnimation * thicknessFactor;
          thicknessInfluence = clamp(thicknessInfluence, 0.2, 0.8);

    float thickness = uThickness * thicknessInfluence;

    float halfThickness = thickness * 0.5;

    //endregion Appearance
    //region Billboarding

    vec3 cameraDirection = normalize(position - uCameraPosition);
    vec3 billboardDirection = normalize(cross(aTangent, cameraDirection));

    // Offset the vertex in opposite directions depending on aVertexId
    vec3 offset = billboardDirection * halfThickness;
    vec3 newPosition = position;

    if (aVertexId == 0.0) {
        newPosition += offset;
        // newPosition.x += halfThickness;
    } else {
        newPosition -= offset;
        // newPosition.x -= halfThickness;
    }

    //endregion billboarding
    //region Slight move in wind direction

    newPosition.z -= uProgress * 0.5;

    //endregion Slight move in wind direction

    gl_Position = projectionMatrix * modelViewMatrix * vec4(newPosition, 1.0);

    //region Varyings

    vThicknessFactor = thicknessFactor;
    vThicknessVariation = globalThicknessAnimation;

    //endregion Varyings
}