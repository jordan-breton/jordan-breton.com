// Vertex shader for water drop particles
attribute float aSize;
attribute vec3 aColor;
attribute vec3 aImpulse;
attribute float aDelay;
attribute float aLifeCycle;

uniform float uTime;
uniform float uSize;
uniform vec2  uResolution;

varying vec3 vColor;
varying float vAlpha;

void main() {
    // Physics constants
    float GRAVITY = 9.81;

    // Calculate adjusted time accounting for delay and lifecycle
    float adjustedTime = uTime - aDelay;

    // Calculate cycle time (0.0 to 1.0) using individual lifecycle duration
    float cycleTime = mod(adjustedTime, aLifeCycle) / aLifeCycle;

    // Convert to physics time (0 to actual seconds)
    float t = cycleTime * aLifeCycle * 0.5;

    // Hide particle if it hasn't started yet (before delay)
    if (adjustedTime < 0.0) {
        gl_Position = vec4(0.0, 0.0, 0.0, 0.0);
        vAlpha = 0.0;
        return;
    }

    // Calculate position using kinematic equations
    // x(t) = x0 + vx * t
    // y(t) = y0 + vy * t - 0.5 * g * t^2
    // z(t) = z0 + vz * t

    vec3 currentPosition = position;

    // Apply impulse velocity over time
    currentPosition.x += aImpulse.x * t;
    currentPosition.z += aImpulse.z * t;

    // Vertical motion with gravity
    // Start with upward impulse, then gravity pulls down
    currentPosition.y += aImpulse.y * t - 0.5 * GRAVITY * t * t;

    // Calculate fade based on lifecycle
    // Fade in quickly at start, fade out as particle falls
    float fadeIn = smoothstep(0.0, 0.1, cycleTime);
    float fadeOut = 1.0 - smoothstep(0.7, 1.0, cycleTime);
    vAlpha = fadeIn * fadeOut;

    // Additional fade based on height (particles become less visible as they fall)
    float heightFade = smoothstep(-0.5, 0.0, currentPosition.y);
    vAlpha *= heightFade;

    // Pass color to fragment shader
    vColor = aColor;

    vec4 modelPosition     = modelMatrix * vec4(currentPosition, 1.0);
    vec4 viewPosition      = viewMatrix * modelPosition;
    vec4 projectedPosition = projectionMatrix * viewPosition;
    gl_Position            = projectedPosition;

    gl_PointSize = uSize * uResolution.y * aSize * heightFade;
    gl_PointSize *= 1.0 / - viewPosition.z;
}