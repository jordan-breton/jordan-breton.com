uniform float uTime;
uniform vec2 uScreenResolution;

attribute float aSize;
attribute float aLifetime;
attribute vec3 aSpeed;   // x/z: sideways drift, y: vertical rise

varying float vAlpha;
varying float vRand;

float hash(float n) { return fract(sin(n) * 43758.5453); }
float noise(float x) {
    float i = floor(x);
    float f = fract(x);
    return mix(hash(i), hash(i + 1.0), smoothstep(0.0, 1.0, f));
}

void main() {
    vec3 newPosition = position;

    // loop duration (visible + pause)
    float phaseDuration = 3.5;  // total cycle length
    float visibleTime   = 2.0;  // how long a spark is visible
    float tAll = mod(uTime + aLifetime * 10.0, phaseDuration);

    // pause phase → invisible
    if (tAll > visibleTime) {
        vAlpha = 0.0;
        gl_Position = vec4(0.0, 0.0, 0.0, 0.0);
        gl_PointSize = 0.0;
        return;
    }

    float t = tAll;

    // upward motion, starts fast then slows (drag curve)
    float rise = aSpeed.y * (1.0 - exp(-t * 2.0));
    newPosition.y += rise;

    // sideways drift (small, not spiral)
    newPosition.x += aSpeed.x * t * 0.1;
    newPosition.z += aSpeed.z * t * 0.1;

    // subtle jitter from noise
    float chaos = (noise(aLifetime * 7.0 + t) - 0.5);
    newPosition.x += chaos * 0.02;
    newPosition.z += chaos * 0.02;

    // fade out
    vAlpha = 1.0 - t / visibleTime;
    vRand = aLifetime;

    vec3 mvPosition = (modelViewMatrix * vec4(newPosition, 1.0)).xyz;
    gl_Position = projectionMatrix * vec4(mvPosition, 1.0);
    gl_PointSize = (0.15 * aSize * uScreenResolution.y) / -mvPosition.z;
}