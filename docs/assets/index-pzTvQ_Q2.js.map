uniform sampler2D currentBuffer;     // vec4(index, size, opacity, rotation)
uniform sampler2D uPositionsTexture; // vec4(x, y, z, 1)
uniform int uStage;
uniform int uOffset;
uniform int uStepNo;
uniform vec3 uCameraPosition;

//------------------------------------------------------------------------------

ivec2 unpack2D(int index, ivec2 dims) {
    return ivec2(index % dims.x, index / dims.x);
}

int pack2D(ivec2 index, ivec2 dims) {
    return index.x + index.y * dims.x;
}

//------------------------------------------------------------------------------

void main() {
    ivec2 dataTextureDims = textureSize(currentBuffer, 0);

    // Current fragment's pixel coordinate
    ivec2 pixelIndex = ivec2(gl_FragCoord.xy - 0.5);

    // Flatten to 1D index
    int pixelIndex1D = pack2D(pixelIndex, dataTextureDims);

    // Determine which texel to compare with
    int csign = (pixelIndex1D % uStage < uOffset) ? 1 : -1;

    // Bitonic sort direction
    int cdir = ((pixelIndex1D / uStepNo) % 2 == 0) ? 1 : -1;

    // Read current texel (index + extra attributes)
    vec4 val0 = texelFetch(currentBuffer, pixelIndex, 0);

    // Read the texel to compare with
    int cmpPixelIndex = pixelIndex1D + csign * uOffset;
    ivec2 cmpPixelCoord = unpack2D(cmpPixelIndex, dataTextureDims);
    vec4 val1 = texelFetch(currentBuffer, cmpPixelCoord, 0);

    // Fetch actual 3D positions using the indices
    ivec2 posDims = textureSize(uPositionsTexture, 0);
    ivec2 posCoord0 = unpack2D(int(val0.x), posDims);
    ivec2 posCoord1 = unpack2D(int(val1.x), posDims);

    vec3 pos0 = texelFetch(uPositionsTexture, posCoord0, 0).xyz;
    vec3 pos1 = texelFetch(uPositionsTexture, posCoord1, 0).xyz;

    // Compute distance to camera for sorting
    float cmpValue0 = distance(pos0, uCameraPosition);
    float cmpValue1 = distance(pos1, uCameraPosition);

    // Choose min/max texel
    vec4 cmin = (cmpValue0 < cmpValue1) ? val0 : val1;
    vec4 cmax = (cmpValue0 <= cmpValue1) ? val1 : val0;

    // Apply sort direction
    gl_FragColor = (csign == cdir) ? cmax : cmin;
}
